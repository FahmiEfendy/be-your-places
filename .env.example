# ============================================================
# YOUR PLACES — BACKEND .env
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env


# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
# The port the backend server will run on
PORT=5001

# The execution environment (development, production, or test)
NODE_ENV=production


# ------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------
# MongoDB Atlas credentials — used to construct the connection URI
DB_USER=your_mongo_user
DB_PASSWORD=your_mongo_password
DB_NAME=your_places

# Or supply a full URI directly (takes precedence over individual fields above)
MONGODB_URI=


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# A long, random string used to sign JWT tokens (min. 32 chars recommended)
JWT_TOKEN_KEY=your_secure_random_secret_key_here

# How long the JWT token remains valid (e.g., 24h, 7d, 3600s)
JWT_TOKEN_EXPIRED=24h


# ------------------------------------------------------------
# External APIs
# ------------------------------------------------------------
# Google Maps / Places API key for geocoding
GOOGLE_API_KEY=your_google_api_key_here


# ------------------------------------------------------------
# Image Manager (Openinary)
# ------------------------------------------------------------
OPENINARY_URL=http://main-openinary:3000
OPENINARY_API_KEY=your_openinary_api_key_here


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Morgan/Winston log format (dev, combined, common, short, tiny)
LOG_FORMAT=combined
